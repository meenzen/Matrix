<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageDescription>Unofficial native matrix-rust-sdk libraries for Matrix.RustSdk.Bindings on Windows (x64 and arm64). Not affiliated with The Matrix.org Foundation.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <NativeLibrary
      Include="$(NativeLibrariesDirectory)win-x64/native/matrix_sdk_ffi.dll"
      PackagePath="runtimes/win-x64/native/"
    />
    <NativeLibrary
      Include="$(NativeLibrariesDirectory)win-arm64/native/matrix_sdk_ffi.dll"
      PackagePath="runtimes/win-arm64/native/"
    />
  </ItemGroup>
  <Import Project="../Native.targets" />
</Project>
