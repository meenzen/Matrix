<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PackageId>Matrix.RustSdk.Bindings</PackageId>
    <PackageDescription>UniFFI bindings for the matrix-rust-sdk crate. The native libraries are shipped separately in the Matrix.RustSdk.Bindings.Native.* packages.</PackageDescription>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- generated code: doc comments from rust don't map cleanly to C# XML docs -->
    <NoWarn>$(NoWarn);CS1570;CS1573;CS1587</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MatrixSdkFfiTag" Value="$(MatrixSdkFfiTag)" />
  </ItemGroup>
</Project>
