<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Matrix.RustSdk</PackageId>
    <PackageDescription>Idiomatic C# helpers for the matrix-rust-sdk bindings (Matrix.RustSdk.Bindings): subscriptions as IAsyncEnumerable, live lists, message helpers and stored sessions. The native libraries are shipped separately in the Matrix.RustSdk.Bindings.Native.* packages. Not affiliated with The Matrix.org Foundation.</PackageDescription>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- the helpers are compiled against the bindings of the same commit, whose API changes with every SDK update -->
    <ExactProjectReferenceVersions>true</ExactProjectReferenceVersions>
    <!-- published API: every public member needs docs, unlike the rest of the repository -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Matrix.RustSdk.Bindings\Matrix.RustSdk.Bindings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- unit tests of the runtime part of the subscriptions -->
    <InternalsVisibleTo Include="Matrix.RustSdk.Tests" />
    <!-- build time only, the generated code is compiled into the assembly -->
    <ProjectReference
      Include="..\Matrix.RustSdk.Generators\Matrix.RustSdk.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>
</Project>
