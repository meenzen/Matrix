<Project Sdk="Microsoft.NET.Sdk">
  <!-- shared setup of the test projects: the homeserver container, the native library under test and snapshots -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <CopyNativeLibrary>true</CopyNativeLibrary>
    <NoWarn>$(NoWarn);VSTHRD200</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="TUnit.Assertions" />
    <PackageReference Include="TUnit.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Matrix.RustSdk.Bindings\Matrix.RustSdk.Bindings.csproj" />
  </ItemGroup>
</Project>
