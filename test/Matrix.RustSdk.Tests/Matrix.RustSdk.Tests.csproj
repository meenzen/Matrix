<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TUnit runs on Microsoft.Testing.Platform, test projects are executables -->
    <OutputType>Exe</OutputType>
    <!-- S2696: tests chained with [DependsOn] share their state in static fields, TUnit creates an instance per test -->
    <NoWarn>$(NoWarn);VSTHRD200;S2696</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Matrix.RustSdk\Matrix.RustSdk.csproj" />
    <ProjectReference Include="..\Matrix.RustSdk.Testing\Matrix.RustSdk.Testing.csproj" />
  </ItemGroup>
</Project>
