<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TUnit runs on Microsoft.Testing.Platform, test projects are executables -->
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);VSTHRD200</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="4.15.0" />
    <PackageReference Include="TUnit" Version="1.72.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Matrix.RustSdk\Matrix.RustSdk.csproj" />
  </ItemGroup>
  <!-- the native library under test, defaults to the debug build, CI passes the release build with -p:NativeLibraryPath=... -->
  <PropertyGroup>
    <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">matrix_sdk_ffi.dll</NativeLibraryName>
    <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libmatrix_sdk_ffi.dylib</NativeLibraryName>
    <NativeLibraryName Condition="'$(NativeLibraryName)' == ''">libmatrix_sdk_ffi.so</NativeLibraryName>
    <NativeLibraryPath Condition="'$(NativeLibraryPath)' == ''"
      >../../external/matrix-rust-sdk/target/debug/$(NativeLibraryName)</NativeLibraryPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- always copy, otherwise switching NativeLibraryPath can leave a newer, different library in the output -->
    <Content Include="$(NativeLibraryPath)" Link="$(NativeLibraryName)">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <Target Name="EnsureNativeLibrary" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(NativeLibraryPath)')"
      Text="Native library not found at $(NativeLibraryPath), run ./scripts/build-debug.sh first."
    />
  </Target>
</Project>
